# ── Server Configuration ───────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# ── Database ───────────────────────────────────────────────
MONGO_URI=your_mongodb_connection_string

# ── JWT Secrets ────────────────────────────────────────────
# Use strong, unique, and randomly generated strings for these secrets.
# You can generate them using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key

# ── Google OAuth & Email (Nodemailer) ──────────────────────
# These are required for the email service to send OTPs.
# Follow a guide on setting up Nodemailer with Gmail for these values.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
GOOGLE_ACCESS_TOKEN=your_google_access_token
GOOGLE_USER=your_gmail_address@gmail.com
